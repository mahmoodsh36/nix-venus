+            cpu_synchronize_state(cpu);
+            error_report("hvf: data abort with ISV=0, syndrome 0x%llx; "
+                         "injecting guest abort instead of aborting",
+                         (unsigned long long)syndrome);
+            cpu->exception_index = EXCP_DATA_ABORT;
+            env->exception.target_el = 1;
+            env->exception.syndrome = (uint32_t)syndrome;
+            arm_cpu_do_interrupt(cpu);
+            break;
+        }
 
